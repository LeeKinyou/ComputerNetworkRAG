# ===== LLM（OpenAI 兼容接口，必填）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
# 必须用「非思考」模型：思考型（deepseek-reasoner、Qwen/Qwen3-8B 等）在这类任务的长 prompt 上
# 会生成超长思维链，单次调用超过 LLM_TIMEOUT 仍不返回，建库会永远停在 processing。
LLM_MODEL=deepseek-chat

# ===== Embedding（必填，可与 LLM 同一厂商）=====
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# ===== 服务 =====
APP_HOST=127.0.0.1
APP_PORT=8000

# ===== RAG / LightRAG =====
LIGHTRAG_WORKING_DIR=data/lightrag
RAG_QUERY_MODE=hybrid
GRAPH_STORAGE=NetworkXStorage
VECTOR_STORAGE=NanoVectorDBStorage

# ===== LightRAG 官方控制台（可选，默认关闭）=====
# 开启后：页面 http://<host>:<port>/webui/ ，接口 /lightrag-api/*
# 控制台带「删文档 / 清空缓存 / 改写图谱实体」的写接口，且下面两项凭据都不配时
# 完全不鉴权 —— 公网服务器上必须先二选一再开启。
LIGHTRAG_CONSOLE=false
# 方式一：LightRAG 自带账号密码登录（页面会出现登录页），格式 user:pass[,user2:pass2]
# AUTH_ACCOUNTS=
# 方式二：只给 X-API-Key 头校验
# LIGHTRAG_API_KEY=

# ===== Agent =====
AGENT_RECURSION_LIMIT=24
HITL_ENABLED=false
APPROVAL_TOOLS=ping_host,http_probe
LLM_TIMEOUT=150
TOOL_TIMEOUT=3

# ===== 上传 =====
UPLOAD_MAX_MB=20
