# ComputerNetworkRAG V2 配置模板
# 当前为设计契约，后端、Compose 和配置读取尚未实现。
# 默认场景：后端在本机运行，PostgreSQL、Redis、MinIO 在本机或映射到本机端口。
# 基础设施连接参数已填本地开发默认值；需先按相同参数创建对应服务。
# 仅复制到本地 .env 后填写。已有 .env 请手动合并，不要直接覆盖。
# 默认账号/密码仅供本地开发；生产部署更换密钥并限制服务访问。
# 云模型 API key 需要填写自己的账号密钥，不能提供通用默认密钥。

# ---------- 应用 ----------
APP_ENV=development
# 本地开发默认值；生产环境替换为随机密钥，所有 API/worker 实例保持一致。
APP_SECRET_KEY=cnrag-v2-local-development-only-change-in-production

# ---------- 业务数据库：sqlite | postgresql ----------
# 唯一数据库选择开关，启动时生效；修改后统一重启 API/worker/dispatcher。
# 切换连接不会自动迁移原库数据，连接失败也不会降级到另一种数据库。
DB_BACKEND=postgresql

# SQLite 模式：无需数据库 IP/账号；相对路径统一相对于项目根目录解析。
# 改成 DB_BACKEND=sqlite 即使用此文件，其他基础设施配置不需要改。
DB_SQLITE_PATH=./runtime/app.db
DB_SQLITE_BUSY_TIMEOUT_MS=5000

# PostgreSQL：IP=127.0.0.1，端口=5432，库=cnrag，账号=cnrag，密码=cnrag_dev_password。
# 需在 PostgreSQL 中创建对应账号与数据库；SQLite 模式忽略此连接。
# 自定义凭据中的特殊字符需 URL 编码。
DB_POSTGRES_DSN=postgresql+asyncpg://cnrag:cnrag_dev_password@127.0.0.1:5432/cnrag
DB_POSTGRES_POOL_SIZE=5
DB_POSTGRES_MAX_OVERFLOW=5

# ---------- Redis：消息队列、缓存、限流、实时通知 ----------
# 两种数据库模式均必需；使用 Redis Streams 实现消息队列，无需 RabbitMQ。
# 本机默认 IP=127.0.0.1，端口=6379，逻辑数据库=0，本地默认不启用密码。
# 若已启用认证，改为 redis://:你的密码@127.0.0.1:6379/0。
REDIS_URL=redis://127.0.0.1:6379/0
# 不同环境使用不同前缀；运行时自动追加 installation_id 隔离数据库任务。
REDIS_NAMESPACE=cnrag:v2:dev
CACHE_TTL_SECONDS=300

# ---------- MinIO：私有对象存储 ----------
# 两种数据库模式均必需；保存课件、附件、报告与不可变检索索引。
# ENDPOINT 不带 http:// 或 https://，是否使用 TLS 由 SECURE 控制。
# 本机默认 IP=127.0.0.1，S3 API 端口=9000；不要填写管理控制台端口。
MINIO_ENDPOINT=127.0.0.1:9000
# 默认本地开发服务账号；需在 MinIO 中创建同名服务凭据并授予 bucket 权限。
MINIO_ACCESS_KEY=cnrag_dev
MINIO_SECRET_KEY=cnrag_dev_minio_password
MINIO_SECURE=false
MINIO_BUCKET=cnrag-v2
# 可选：未来预签名直传/下载使用的浏览器可访问端点；初期通过 API 传文件。
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_SECURE=false

# ---------- 后台任务 ----------
# SQLite：单 worker 进程，执行并发必须为 1。
# PostgreSQL：按实现与压测结果调整，默认仍为 1。
WORKER_CONCURRENCY=1
# 单位：秒。心跳间隔应小于租约时长；确认消息不等于完成业务幂等。
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=10
# 最大执行尝试次数，含首次执行。
JOB_MAX_ATTEMPTS=3

# ---------- 检索 ----------
# 两种 SQL 数据库使用同一基线；正式索引在 MinIO，本地仅缓存副本。
# 当前设计仅启用 snapshot，不使用 pgvector 作为运行前提。
RETRIEVAL_BACKEND=snapshot
# 相对路径统一以项目根目录为基准，后续实现负责创建缓存目录。
RETRIEVAL_CACHE_DIR=./runtime/index-cache
# 单个索引产物的配置容量上限，单位：字节；256 MiB。
# 装载仍需校验实际运行内存预算，不能据此保证峰值内存不超限。
RETRIEVAL_MAX_INDEX_BYTES=268435456

# ---------- Agent 检查点 ----------
# 后端随 DB_BACKEND 选择；此路径仅用于 SQLite，区别于业务数据库文件。
# 相对路径统一以项目根目录为基准。
CHECKPOINT_SQLITE_PATH=./runtime/checkpoints.db
# PostgreSQL saver 连接从 DB_POSTGRES_DSN 派生，使用独立支持的驱动/连接池。
# 无需再配置第二个数据库地址。

# ---------- 文本与工具调用模型 ----------
# 使用项目适配器支持的 OpenAI 兼容接口；模型需支持工具调用与结构化输出。
# 默认 DeepSeek 接口；使用其他供应商时同时调整地址、模型名和密钥。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# ---------- Embedding 模型 ----------
# 可与文本模型使用不同服务；必须与已发布索引记录的模型/维度一致。
# 更换模型或向量维度后需重建索引，不能只修改配置复用旧向量。
# 默认 SiliconFlow 的 BGE-M3 接口；密钥与 DeepSeek 密钥分别填写。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
