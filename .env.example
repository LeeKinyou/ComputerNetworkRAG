# ===== LLM（OpenAI 兼容接口，必填）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== Embedding（必填，可与 LLM 同一厂商）=====
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# ===== 服务 =====
APP_HOST=127.0.0.1
APP_PORT=8000

# ===== RAG / LightRAG =====
LIGHTRAG_WORKING_DIR=data/lightrag
RAG_QUERY_MODE=hybrid
GRAPH_STORAGE=NetworkXStorage
VECTOR_STORAGE=NanoVectorDBStorage

# ===== Agent =====
AGENT_RECURSION_LIMIT=24
HITL_ENABLED=false
APPROVAL_TOOLS=ping_host,http_probe
LLM_TIMEOUT=150
TOOL_TIMEOUT=3

# ===== 上传 =====
UPLOAD_MAX_MB=20
